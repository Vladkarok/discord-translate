# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Discord ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_PUBLIC_KEY=
OWNER_DISCORD_ID=

# --- Google Cloud Translation v2 (only provider in v1) ---
# Create in Google Cloud Console:
#   1. Create a project
#   2. Enable the "Cloud Translation API"
#   3. APIs & Services → Credentials → Create API key
#   4. Restrict the key to "Cloud Translation API"
# Free tier: 500,000 characters/month, permanent.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_MONTHLY_CHAR_LIMIT=500000

# --- Cache behaviour ---
# false = hash-only cache (default, privacy-preserving).
# true  = also store raw source text. Off in production.
CACHE_STORE_SOURCE_TEXT=false

# --- Quota / behaviour ---
ALLOW_PAID_OVERFLOW=false
DEFAULT_TARGET_LANGUAGE=en
DATABASE_PATH=/data/bot.sqlite
LOG_LEVEL=info

# Discord global-command registration runs on container start by default.
# Set true during dev iteration to skip and avoid Discord rate limits.
SKIP_COMMAND_REGISTRATION=false

# --- DeepL (legacy, unused in v1 after the pivot to Google) ---
# Existing DeepL Free API users (signups closed for new accounts) can
# wire these up in a future provider swap.
# DEEPL_API_KEY=
# DEEPL_API_URL=https://api-free.deepl.com
# DEEPL_MONTHLY_CHAR_LIMIT=500000
