{
  "name": "discord-translate",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Discord translation bot (DeepL Free, ephemeral message-context translate)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "discord.js": "^14.26.4",
    "zod": "^4.4.3"
  }
}
